{
  "name": "alfalfa_web",
  "version": "1.0.0",
  "description": "A Haystack implementation",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "run-s clean && run-p build-app build-docs build-server",
    "build-app": "webpack",
    "build-docs": "node ./generate-docs.js",
    "build-server": "babel -d ./build ./server",
    "clean": "npx rimraf build",
    "start": "node ./build/index.js",
    "start-dev": "test -f ../.env && (env-cmd -f ../.env npm start) || npm start",
    "watch": "run-p watch-app watch-docs watch-server",
    "watch-app": "webpack --watch",
    "watch-docs": "supervisor -e js -w generate-docs.js,server/api-v2.js,server/api-haystack.js -n exit -t generate-docs.js",
    "watch-server": "supervisor -e js -w server -x run-s -- build-server start-dev"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/credential-providers": "^3.1147.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-date-pickers": "^9.15.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "connect-history-api-fallback": "^2.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "ky": "^2.1.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "nodehaystack": "github:NatLabRockies/nodehaystack#5ffec6835fb63dc2212c07f16e81d191ef05bffb",
    "normalize.css": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0",
    "simple-body-validator": "^1.2.13",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-class-properties": "^7.24.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@redocly/cli": "^2.60.0",
    "babel-loader": "^10.1.1",
    "before-build-webpack": "^0.2.13",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.5",
    "env-cmd": "^11.0.0",
    "html-webpack-plugin": "^5.6.8",
    "mkdirp": "^3.0.1",
    "sass": "^1.105.1",
    "npm-run": "^5.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "rimraf": "^6.1.3",
    "sass-loader": "^17.0.1",
    "should": "^13.2.3",
    "style-loader": "^4.0.0",
    "supertest": "7.3.1",
    "supervisor": "github:axelstudios/node-supervisor#4e4185b81a9724af26922a2ceb1895bf6ef564b5",
    "swagger-jsdoc": "^6.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
